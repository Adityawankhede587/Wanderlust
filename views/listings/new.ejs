<% layout("/layouts/boilerplate") %>

    <h3 class="col-6 offset-3">Create A new listing</h3>
    <div class="row mt-3">
        <div class="col-6 offset-3">
            <form method="post" action="/listing" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" required placeholder="enter a catchy title" class="form-control">
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" required class="form-control"></textarea>
                <div class="invalid-feedback">Please Enter a Short Description</div>
                </div>
              
                 <div class="mb-3">
                    <label for="image" class="form-label">Uplode Listing image</label>
                    <input type="file" name="listing[image]" class="form-control">
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">price</label>
                        <input  class="form-control" required placeholder="1200" name="listing[price]">
                         <div class="invalid-feedback">Price should be Valid</div>

                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" name="listing[country]" required placeholder="India" class="form-control">
                        <div class="invalid-feedback">Country Should be Valid</div>

                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" name="listing[location]" required placeholder="jaipur,Rajasthan" class="form-control">
                    <div class="invalid-feedback">Location should be Valid</div>

                </div>
                <button class="btn btn-dark add-btn mt-3">Add</button>
               
            </form>

        </div>
    </div>